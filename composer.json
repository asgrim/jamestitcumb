{
    "name": "asgrim/jamestitcumb",
    "description": "My personal website at www.jamestitcumb.com",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "8.4.*",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "azjezz/psl": "^3.3",
        "elasticsearch/elasticsearch": "^7.17.3",
        "guzzlehttp/guzzle": "^7.15.5",
        "laminas/laminas-config-aggregator": "^1.20",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-feed": "^2.26.1",
        "laminas/laminas-httphandlerrunner": "^2.13",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-stratigility": "^3.14.1",
        "laminas/laminas-view": "^2.44",
        "mezzio/mezzio": "^3.23.2",
        "mezzio/mezzio-fastroute": "^3.14",
        "mezzio/mezzio-helpers": "^5.20",
        "mezzio/mezzio-laminasviewrenderer": "^2.19",
        "mezzio/mezzio-router": "^3.20",
        "mezzio/mezzio-template": "^2.13",
        "michelf/php-markdown": "^2.0",
        "monolog/monolog": "^3.12",
        "php-http/discovery": "^1.20",
        "psr/container": "^1.1.2",
        "psr/http-client": "^1.0.3",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/http-server-middleware": "^1.0.2",
        "psr/log": "^3.0.2",
        "robmorgan/phinx": "^0.16.12",
        "symfony/console": "^7.4.18",
        "symfony/yaml": "^7.4.18",
        "webmozart/assert": "^1.12.1"
    },
    "require-dev": {
        "colinodell/psr-testlogger": "^1.3.1",
        "doctrine/coding-standard": "^14",
        "mezzio/mezzio-tooling": "^2.10.x-dev",
        "php-standard-library/psalm-plugin": "^2.4",
        "phpunit/phpunit": "^11.5.56",
        "roave/security-advisories": "dev-master",
        "vimeo/psalm": "^6.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Asgrim\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AsgrimTest\\": "test/unit/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "James Titcumb",
            "email": "james@asgrim.com"
        }
    ],
    "scripts": {
        "post-update-cmd": [
            "vendor/bin/phinx migrate",
            "./app.php index-posts",
            "./app.php cache-ratings"
        ],
        "post-install-cmd": [
            "vendor/bin/phinx migrate",
            "./app.php index-posts",
            "./app.php cache-ratings"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "bump-after-update": true,
        "allow-plugins": {
            "ocramius/package-versions": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-component-installer": true,
            "php-http/discovery": true
        }
    }
}
